{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Design Constraints: the exact shape of a design","description":"Authoritative shape of a complete robot design. A design is ONE concrete robot: every field holds a single concrete value, never a range, an option list or a description of bounds. Numeric ranges and allowed values are given separately in race_constraints; choose values inside them.","type":"object","required":["geometry","controller","observation_request"],"additionalProperties":false,"properties":{"geometry":{"type":"object","required":["sensor_positions","sensor_size","wheel_track","wheel_radius","body_width","body_length","mass"],"additionalProperties":false,"properties":{"sensor_positions":{"type":"array","items":{"type":"object","required":["x","y"],"additionalProperties":false,"properties":{"x":{"type":"number"},"y":{"type":"number"}}}},"sensor_size":{"type":"number"},"wheel_track":{"type":"number"},"wheel_radius":{"type":"number"},"body_width":{"type":"number"},"body_length":{"type":"number"},"mass":{"type":"number"}}},"controller":{"type":"object","required":["base_speed","kp","ki","kd","sensor_weights","line_loss"],"additionalProperties":false,"properties":{"base_speed":{"type":"number"},"kp":{"type":"number"},"ki":{"type":"number"},"kd":{"type":"number"},"sensor_weights":{"type":"array","items":{"type":"number"}},"line_loss":{"enum":["stop","search_left","search_right","last_direction"]}}},"observation_request":{"type":"object","description":"Measurements you want reported back after the race. Must list at least one allowed name.","required":["measurements"],"additionalProperties":false,"properties":{"measurements":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["completion","progress","completion_time","rms_error","max_error","line_loss_events","steering_oscillation","control_effort","controller_errors","noise_robustness"]}}}}}}

{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Design Constraints: the exact shape of a design","description":"Authoritative shape of a robot design. Geometry must be ONE concrete robot, not ranges or option lists. Numeric ranges and allowed sensor sizes are in race_constraints.","type":"object","required":["geometry","controller"],"additionalProperties":false,"properties":{"geometry":{"type":"object","required":["sensor_positions","sensor_size","wheel_track","wheel_radius","body_width","body_length","mass"],"additionalProperties":false,"properties":{"sensor_positions":{"type":"array","items":{"type":"object","required":["x","y"],"additionalProperties":false,"properties":{"x":{"type":"number"},"y":{"type":"number"}}}},"sensor_size":{"type":"number"},"wheel_track":{"type":"number"},"wheel_radius":{"type":"number"},"body_width":{"type":"number"},"body_length":{"type":"number"},"mass":{"type":"number"}}},"controller":{"type":"object","required":["base_speed","kp","ki","kd","sensor_weights","line_loss"],"additionalProperties":false,"properties":{"base_speed":{"type":"number"},"kp":{"type":"number"},"ki":{"type":"number"},"kd":{"type":"number"},"sensor_weights":{"type":"array","items":{"type":"number"}},"line_loss":{"enum":["stop","search_left","search_right","last_direction"]}}}}}